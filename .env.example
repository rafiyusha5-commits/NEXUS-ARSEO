# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only key for inviting and administering users.
# Supabase: Project Settings -> API Keys -> Secret keys. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy fallback. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of Nexus, e.g. https://nexus.example.kz (scheme and host only, no path). Server-only.
# Links in password-reset and invitation e-mails lead here; add <APP_ORIGIN>/auth/callback to
# Supabase: Authentication -> URL Configuration -> Redirect URLs. Required in production; request headers are never trusted for email origins.
APP_ORIGIN=

# Direct PostgreSQL connection for migrations and future server jobs
DATABASE_URL=

# Google integration. Share sources with this account as Viewer only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; use an escaped single-line value with \n in deployment settings.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI providers
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Internal web assistant (docs/ai-assistant.md). Disabled unless AGENT_ENABLED=true AND the transfer of
# question text and allow-listed Nexus data to the model provider is acknowledged. Never commit values.
AGENT_ENABLED=
AGENT_ACKNOWLEDGE_DATA_TRANSFER=
# Provider: openai (uses OPENAI_API_KEY). Model id of the provider.
AGENT_PROVIDER=
# GPT-5.6 Terra: gpt-5.6-terra; Responses API, low reasoning by default.
AGENT_REASONING_EFFORT=
AGENT_MODEL=
# Telegram local pilot; all values are server-only.
TELEGRAM_ENABLED=
TELEGRAM_AUTH_ACKNOWLEDGED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WORKER_SECRET=
TELEGRAM_VOICE_ENABLED=
TELEGRAM_VOICE_ACKNOWLEDGED=
# USD per one million input / output tokens; required to reserve the monthly budget conservatively.
AGENT_PRICE_INPUT_USD_PER_MTOK=
AGENT_PRICE_OUTPUT_USD_PER_MTOK=
# Optional per-request limits (safe defaults): steps, tool calls, input/output tokens, provider timeout ms.
AGENT_MAX_STEPS=
AGENT_MAX_TOOL_CALLS=
AGENT_MAX_INPUT_TOKENS=
AGENT_MAX_OUTPUT_TOKENS=
AGENT_PROVIDER_TIMEOUT_MS=

# OCR for scanned/photographed source documents. Disabled unless OCR_PROVIDER is set AND the transfer is
# acknowledged: documents (including driver and vehicle papers) are sent to the provider. Never commit values.
# Provider: google_vision | http (your own HTTPS OCR service) | empty = disabled
OCR_PROVIDER=
OCR_ACKNOWLEDGE_DATA_TRANSFER=
OCR_GOOGLE_VISION_API_KEY=
OCR_HTTP_ENDPOINT=
OCR_HTTP_TOKEN=
# Optional limits (defaults are safe): file bytes (max 4194304), pages (max 10), pixels, timeout ms,
# scans per run, attempts per document, job lease seconds, run budget ms.
OCR_MAX_FILE_BYTES=
OCR_MAX_PAGES=
OCR_MAX_PIXELS=
OCR_TIMEOUT_MS=
OCR_MAX_DOCUMENTS_PER_RUN=
OCR_MAX_ATTEMPTS=
OCR_LEASE_SECONDS=
OCR_RUN_BUDGET_MS=
# Separately enable OCR of the approved Drive catalog through the existing Nexus HTTP engine.
DRIVE_CATALOG_OCR_ENABLED=false
# Server-only 32 random bytes encoded as 64 lowercase hex characters.
# Provision its SHA-256 hash in private.drive_gateway_config; see docs/drive-archive-access.md.
DRIVE_CATALOG_GATEWAY_SECRET=

# Monitoring is opt-in. Public health endpoints return only ok/unavailable.
# Provision a tiny private canary separately; these checks never upload or repair it.
MONITORING_ENABLED=false
MONITORING_ENVIRONMENT=
MONITORING_SERVICE_KEY=
MONITORING_STORAGE_BUCKET=
MONITORING_STORAGE_OBJECT=
MONITORING_STORAGE_SHA256=
# Absolute private directory outside public/, repository and shared folders.
MONITORING_LOG_DIRECTORY=
# Explicit modes: disabled, manual, scheduled (scheduled requires a real agreed heartbeat).
MONITORING_DRIVE_MODE=
MONITORING_OCR_MODE=
MONITORING_TELEGRAM_MODE=
MONITORING_DRIVE_INTERVAL_SECONDS=300
MONITORING_OCR_INTERVAL_SECONDS=300
MONITORING_TELEGRAM_INTERVAL_SECONDS=300
# App has only the verification public key; the backup operator retains the signing key.
MONITORING_BACKUP_MANIFEST=
MONITORING_BACKUP_PUBLIC_KEY=
# Independent observer: an approved reachable origin, never an automatically exposed localhost.
MONITORING_APP_ORIGIN=
MONITORING_WINDOW_FILE=
MONITORING_EXTERNAL_ENABLED=false
MONITORING_EXTERNAL_ENDPOINT=
MONITORING_EXTERNAL_TOKEN=
