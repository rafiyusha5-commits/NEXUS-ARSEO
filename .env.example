# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only key for inviting and administering users.
# Supabase: Project Settings -> API Keys -> Secret keys. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy fallback. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection for migrations and future server jobs
DATABASE_URL=

# Google integration. Share sources with this account as Viewer only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; use an escaped single-line value with \n in deployment settings.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI providers
OPENAI_API_KEY=
NVIDIA_API_KEY=

# OCR for scanned/photographed source documents. Disabled unless OCR_PROVIDER is set AND the transfer is
# acknowledged: documents (including driver and vehicle papers) are sent to the provider. Never commit values.
# Provider: google_vision | http (your own HTTPS OCR service) | empty = disabled
OCR_PROVIDER=
OCR_ACKNOWLEDGE_DATA_TRANSFER=
OCR_GOOGLE_VISION_API_KEY=
OCR_HTTP_ENDPOINT=
OCR_HTTP_TOKEN=
# Optional limits (defaults are safe): file bytes (max 4194304), pages (max 10), pixels, timeout ms,
# scans per run, attempts per document, job lease seconds, run budget ms.
OCR_MAX_FILE_BYTES=
OCR_MAX_PAGES=
OCR_MAX_PIXELS=
OCR_TIMEOUT_MS=
OCR_MAX_DOCUMENTS_PER_RUN=
OCR_MAX_ATTEMPTS=
OCR_LEASE_SECONDS=
OCR_RUN_BUDGET_MS=
